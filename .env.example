# Copy to .env for local development. In AWS these come from Secrets Manager / SSM.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://retailgeo:retailgeo@localhost:5432/retailgeo
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_ITERATIONS=600000
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
PAYMENT_PROVIDER=mock        # mock | stripe
STRIPE_SECRET_KEY=
GEOCODER=gazetteer           # gazetteer | mapbox
MAPBOX_TOKEN=
ADMIN_MFA=true
LOG_LEVEL=info
# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_MAP_PROVIDER=leaflet    # schematic | leaflet
